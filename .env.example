# Copier ce fichier en `.env` et renseigner les valeurs (le fichier .env n'est jamais versionné).

# Django
DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Cloudflare R2 (compatible S3)
# Jeton API R2 : Cloudflare Dashboard > R2 > Manage R2 API Tokens (permission "Object Read & Write")
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=saphir-candidature
# Format : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
